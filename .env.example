# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Used by the running API: the limited lepara_app user (see db/setup/create-app-user.sql)
DATABASE_URL=postgres://lepara_app:CHANGE_ME@localhost:5432/lepara_dev

# Used by migrations and seeds: the database owner. Falls back to DATABASE_URL if empty.
MIGRATION_DATABASE_URL=postgres://lepara_owner:CHANGE_ME@localhost:5432/lepara_dev

# Used by automated tests. The database name MUST end in _test, because tests wipe it.
TEST_DATABASE_URL=postgres://lepara_owner:CHANGE_ME@localhost:5432/lepara_test

# true for cloud databases (Azure, Supabase, Neon). Production always uses SSL.
# Remove any ?sslmode=... from the connection strings and use these instead.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000

# --- Web access -------------------------------------------------------------
# Comma-separated website addresses allowed to call the API from a browser.
# The mobile app needs no entry.
CORS_ORIGINS=http://localhost:5173

# Proxies in front of the API: 1 on Azure App Service or Render, 0 on your own machine
TRUST_PROXY=0

# --- First super admin, created by `npm run seed` ---------------------------
SEED_ADMIN_USERNAME=founder
SEED_ADMIN_EMAIL=
SEED_ADMIN_FULL_NAME=
SEED_ADMIN_PASSWORD=

# --- Admin sign-in -----------------------------------------------------------
# Signs admins' access tokens. Make one with this command and paste the output:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ADMIN_SECRET=

# Encrypts the authenticator-app secrets: exactly 64 hex characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it on a server where admins have set up 2FA: their apps would stop working.
TOTP_ENCRYPTION_KEY=

# --- Added in later phases --------------------------------------------------
# JWT_CUSTOMER_SECRET,
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, MAIL_FROM,
# FIREBASE_SERVICE_ACCOUNT, STORAGE_URL or CLOUDINARY_URL,
# PAYFAST_MERCHANT_ID, PAYFAST_MERCHANT_KEY, PAYFAST_PASSPHRASE, PAYFAST_SANDBOX,
# DELIVERY_FEE_CENTS
